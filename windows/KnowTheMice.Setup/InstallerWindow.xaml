<Window x:Class="KnowTheMice.Setup.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Know The Mice Setup" 
        Height="500" Width="660"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Inter">

    <Window.Resources>
        <SolidColorBrush x:Key="AmoledBg" Color="#000000"/>
        <SolidColorBrush x:Key="BrandOrange" Color="#FF5A00"/>
        <SolidColorBrush x:Key="BrandHighlight" Color="#FF8A00"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A1A1AA"/>

        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF8A00" Offset="0"/>
            <GradientStop Color="#FF5A00" Offset="0.5"/>
            <GradientStop Color="#D93600" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassPanelGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#18FF8A00" Offset="0"/>
            <GradientStop Color="#08FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassPanelGradient}"/>
            <Setter Property="BorderBrush" Value="#30FFA550"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="20,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Outer Window Border with Glow -->
    <Border Background="{StaticResource AmoledBg}" BorderBrush="#40FF8A00" BorderThickness="1.5" CornerRadius="18" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Draggable Title Bar -->
            <Border Grid.Row="0" Background="#060606" CornerRadius="17,17,0,0" BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" Background="#000000" BorderThickness="0" CornerRadius="3" Margin="0,0,10,0" ClipToBounds="True">
                            <Image Source="pack://application:,,,/logo.png" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="Know The Mice — Setup Wizard" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="✕" Width="28" Height="28" Background="Transparent" Foreground="#80FFFFFF" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- Content Container -->
            <Grid Grid.Row="1" Margin="32,24,32,24">
                <!-- STEP 1: WELCOME SCREEN -->
                <Grid x:Name="StepWelcome" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Borderless 15% Logo Container -->
                        <Border Width="96" Height="96" Background="#000000" BorderThickness="0" CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,20" ClipToBounds="True">
                            <Image Source="pack://application:,,,/logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <TextBlock Text="KNOW THE MICE" Foreground="White" FontWeight="Bold" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Your phone. Your PC. Connected." Foreground="{StaticResource BrandHighlight}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Turn your Android device into a low-latency wireless mouse, keyboard, and remote control over local Wi-Fi." 
                                   Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" Margin="0,0,0,28"/>

                        <Button Content="GET STARTED  ➔" Style="{StaticResource PrimaryButton}" Click="BtnWelcomeNext_Click" HorizontalAlignment="Center" Width="200"/>
                    </StackPanel>
                </Grid>

                <!-- STEP 2: INSTALL OPTIONS & LOCATION -->
                <Grid x:Name="StepOptions" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="INSTALLATION PREFERENCES" Foreground="White" FontWeight="Bold" FontSize="18" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure where and how Know The Mice will be installed." Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <!-- Location Card -->
                        <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Destination Folder" Foreground="White" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtInstallDir" Background="#0C0C0C" Foreground="White" BorderBrush="#30FFFFFF" Padding="10,8" FontSize="12" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButton}" Click="BtnBrowse_Click" Margin="8,0,0,0" Padding="12,8" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Shortcuts & Options Card -->
                        <Border Style="{StaticResource GlassCard}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Shortcuts &amp; Startup" Foreground="White" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkDesktop" Content="Create Desktop Shortcut" Foreground="White" IsChecked="True" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkStartMenu" Content="Create Start Menu Shortcut" Foreground="White" IsChecked="True" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkStartup" Content="Start Know The Mice minimized with Windows" Foreground="White" IsChecked="True" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkFirewall" Content="Allow local Wi-Fi inbound control (Port 52841)" Foreground="White" IsChecked="True"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Button Content="BACK" Style="{StaticResource SecondaryButton}" Click="BtnOptionsBack_Click" HorizontalAlignment="Left"/>
                        <Button Content="INSTALL NOW  ➔" Style="{StaticResource PrimaryButton}" Click="BtnOptionsInstall_Click" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>

                <!-- STEP 3: INSTALLING PROGRESS SCREEN -->
                <Grid x:Name="StepInstalling" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
                        <Border Width="64" Height="64" Background="#000000" BorderBrush="{StaticResource BrandHighlight}" BorderThickness="2" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,24" ClipToBounds="True">
                            <Image Source="pack://application:,,,/logo.png" Stretch="Uniform"/>
                        </Border>

                        <TextBlock Text="INSTALLING KNOW THE MICE..." Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtProgressStatus" Text="Extracting application components..." Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <!-- Custom Liquid Glass Progress Bar -->
                        <Border Background="#10FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="8" Height="14" Margin="0,0,0,8" ClipToBounds="True">
                            <Grid>
                                <ProgressBar x:Name="PrgInstall" Value="35" Minimum="0" Maximum="100" Height="14" Foreground="{StaticResource BrandGradient}" Background="Transparent" BorderThickness="0"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="TxtProgressPct" Text="35%" Foreground="{StaticResource BrandHighlight}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <!-- STEP 4: COMPLETED SCREEN -->
                <Grid x:Name="StepCompleted" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="72" Height="72" Background="#1522C55E" BorderBrush="#3022C55E" BorderThickness="2" CornerRadius="36" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <TextBlock Text="✓" Foreground="#22C55E" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="KNOW THE MICE IS READY" Foreground="White" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Setup has successfully installed Know The Mice on your computer." Foreground="{StaticResource TextSecondary}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,28"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="LAUNCH KNOW THE MICE" Style="{StaticResource PrimaryButton}" Click="BtnLaunch_Click" Margin="0,0,12,0"/>
                            <Button Content="CLOSE" Style="{StaticResource SecondaryButton}" Click="BtnClose_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
