<Application x:Class="KnowTheMice.Host.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Liquid Glass System Theme Brushes -->
        <SolidColorBrush x:Key="AmoledBackground" Color="#000000"/>
        <SolidColorBrush x:Key="SurfaceBackground" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="BrandOrange" Color="#FF5A00"/>
        <SolidColorBrush x:Key="BrandHighlight" Color="#FF8A00"/>
        <SolidColorBrush x:Key="BrandDeep" Color="#D93600"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="GlassBorder" Color="#47FFA550"/>

        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF8A00" Offset="0"/>
            <GradientStop Color="#FF5A00" Offset="0.5"/>
            <GradientStop Color="#D93600" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassPanelGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#24FF8A00" Offset="0"/>
            <GradientStop Color="#0AFFFFFF" Offset="1"/>
        </LinearGradientBrush>
    </Application.Resources>
</Application>
