<Application x:Class="KnowTheMice.Host.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Liquid Glass System Theme Brushes -->
        <SolidColorBrush x:Key="AmoledBackground" Color="#000000"/>
        <SolidColorBrush x:Key="SurfaceBackground" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="BrandOrange" Color="#FF5A00"/>
        <SolidColorBrush x:Key="BrandHighlight" Color="#FF8A00"/>
        <SolidColorBrush x:Key="BrandDeep" Color="#D93600"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="GlassBorder" Color="#47FFA550"/>

        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF8A00" Offset="0"/>
            <GradientStop Color="#FF5A00" Offset="0.5"/>
            <GradientStop Color="#D93600" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF8A00" Offset="0"/>
            <GradientStop Color="#FF5A00" Offset="0.5"/>
            <GradientStop Color="#D93600" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SecondaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#29FF8A00" Offset="0"/>
            <GradientStop Color="#0DD93600" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFA333" Offset="0"/>
            <GradientStop Color="#FF5A00" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BorderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#73FF8A00" Offset="0"/>
            <GradientStop Color="#33FF5A00" Offset="0.5"/>
            <GradientStop Color="#59D93600" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SurfaceGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#B3141414" Offset="0"/>
            <GradientStop Color="#E60A0A0A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HoverGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFA033" Offset="0"/>
            <GradientStop Color="#FF6B1A" Offset="0.5"/>
            <GradientStop Color="#E64000" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ActiveGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E65000" Offset="0"/>
            <GradientStop Color="#CC4500" Offset="0.5"/>
            <GradientStop Color="#B32D00" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DisabledGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#14FFFFFF" Offset="0"/>
            <GradientStop Color="#08FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassPanelGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#24FF8A00" Offset="0"/>
            <GradientStop Color="#0AFFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Title Bar Control Button Styles -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F1F1F"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2B2B2B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C40F1D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
