<Window x:Class="KnowTheMice.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Know The Mice — Host Dashboard" 
        Height="620" Width="840"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AmoledBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI, Inter">

    <Window.Resources>
        <Style x:Key="GlassBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassPanelGradient}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <!-- OTA Update Notification Banner -->
            <Border x:Name="UpdateBanner" Margin="0,0,0,14" Background="#30FF5E00" BorderBrush="#FF5E00" BorderThickness="1.5" CornerRadius="12" Padding="16,10" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock x:Name="TxtUpdateTitle" Text="New Update Available!" FontWeight="Bold" FontSize="13" Foreground="White"/>
                            <TextBlock x:Name="TxtUpdateDesc" Text="Faster input engine, new UI/UX, and performance enhancements." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar x:Name="PrgUpdate" Width="100" Height="10" Margin="0,0,12,0" Visibility="Collapsed"/>
                        <Button x:Name="BtnRestartUpdate" Content="RESTART TO UPDATE" Style="{StaticResource PrimaryButton}" Click="BtnRestartUpdate_Click" Padding="14,6" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource GlassBorder}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" Background="#000000" BorderBrush="#FF5E00" BorderThickness="1.5" CornerRadius="10" Margin="0,0,16,0" ClipToBounds="True">
                            <Image Source="pack://application:,,,/logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="KNOW THE MICE" FontWeight="Bold" FontSize="18" Foreground="White"/>
                            <TextBlock Text="Local Wireless Remote Control Host · v1.1.0" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1522C55E" BorderBrush="#3022C55E" BorderThickness="1" CornerRadius="20" Padding="14,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,8,0"/>
                                <TextBlock Text="HOST ONLINE" FontWeight="Bold" FontSize="11" Foreground="#22C55E"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Main Body Content Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Status & Network Info -->
            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <Border Style="{StaticResource GlassBorder}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="HOST NETWORK STATUS" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrandHighlight}" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Computer Name:" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                            <TextBlock x:Name="TxtPcName" Text="DESKTOP-PC" Foreground="White" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Local IP Address:" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                            <TextBlock x:Name="TxtIpAddress" Text="192.168.1.150" Foreground="White" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Control Port:" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                            <TextBlock Text="52841 (TCP)" Foreground="White" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Discovery Beacon:" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                            <TextBlock Text="52840 (UDP Broadcast)" Foreground="White" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Active Controllers:" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                            <TextBlock x:Name="TxtClientCount" Text="0 Connected" Foreground="{StaticResource BrandHighlight}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Pairing Code Card / Modal trigger -->
                <Border Style="{StaticResource GlassBorder}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="DEVICE PAIRING" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrandHighlight}" Margin="0,0,0,10"/>
                        <TextBlock Text="Generate a temporary 6-digit code to securely authenticate a new phone without passwords." 
                                   Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Active PIN Display Box -->
                        <Border x:Name="PinDisplayBox" Background="#0A0A0A" BorderBrush="{StaticResource BrandHighlight}" BorderThickness="1.5" CornerRadius="12" Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="PAIRING CODE (EXPIRES IN 60s)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtPinCode" Text="8 4 9 2 0 1" FontSize="32" FontWeight="Bold" Foreground="{StaticResource BrandHighlight}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnPair" Content="GENERATE PAIRING PIN" Style="{StaticResource PrimaryButton}" Click="BtnPair_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right Column: Settings & Security -->
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <Border Style="{StaticResource GlassBorder}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="INPUT ENGINE SETTINGS" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrandHighlight}" Margin="0,0,0,14"/>

                        <TextBlock Text="Mouse Sensitivity" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                        <Slider x:Name="SliderSensitivity" Minimum="0.2" Maximum="3.0" Value="1.0" ValueChanged="SliderSensitivity_ValueChanged" Margin="0,0,0,12"/>

                        <CheckBox x:Name="ChkNaturalScroll" Content="Natural Two-Finger Scrolling" Foreground="White" IsChecked="True" Checked="ChkNaturalScroll_Checked" Unchecked="ChkNaturalScroll_Unchecked" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkDirectConnect" Content="Direct Connect on Local LAN (No PIN)" Foreground="White" IsChecked="True" Checked="ChkDirectConnect_Checked" Unchecked="ChkDirectConnect_Unchecked" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkStartWithWindows" Content="Start Minimized with Windows" Foreground="White" Margin="0,0,0,8"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassBorder}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="TRUSTED DEVICES" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrandHighlight}" Margin="0,0,0,12"/>
                        <ListBox x:Name="ListTrustedDevices" Height="120" Background="#080808" BorderBrush="#20FFFFFF" BorderThickness="1" Foreground="White" Margin="0,0,0,12">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FriendlyName}" Padding="6,4"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button x:Name="BtnRevoke" Content="REVOKE SELECTED DEVICE" Background="#20EF4444" Foreground="#EF4444" FontWeight="Bold" FontSize="11" Padding="12,8" BorderThickness="1" BorderBrush="#40EF4444" Click="BtnRevoke_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Bottom Footer Bar -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="12,0">
            <Grid>
                <TextBlock x:Name="TxtStatusLog" Text="● Ready for connections on 0.0.0.0:52841" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCheckUpdates" Content="Check for Updates" Background="Transparent" Foreground="#80FFFFFF" BorderThickness="0" FontSize="11" Cursor="Hand" Click="BtnCheckUpdates_Click" Margin="0,0,16,0"/>
                    <TextBlock Text="Zero Cloud · End-to-End Local Encryption" FontSize="11" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
