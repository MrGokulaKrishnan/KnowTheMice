<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Know The Mice" 
           Manufacturer="Know The Mice Team" 
           Version="1.0.0.0" 
           UpgradeCode="A7D4E12C-5F4B-4E7B-9A5A-617F9A0B8A7C"
           Scope="perMachine">
    
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\KnowTheMice.Host\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Know The Mice" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Know The Mice" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="550E8400-E29B-41D4-A716-446655440001">
        <File Id="KnowTheMiceHostExe" 
              Source="..\KnowTheMice.Host\bin\Release\net8.0-windows\win-x64\publish\KnowTheMice.Host.exe" 
              KeyPath="yes" />

        <!-- Start Menu Shortcut -->
        <Shortcut Id="StartMenuShortcut"
                  Directory="ApplicationProgramsFolder"
                  Name="Know The Mice"
                  Description="Wireless Remote Control Host"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon"
                  Advertise="yes" />

        <!-- Desktop Shortcut -->
        <Shortcut Id="DesktopShortcut"
                  Directory="DesktopFolder"
                  Name="Know The Mice"
                  Description="Wireless Remote Control Host"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon"
                  Advertise="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="Know The Mice Host" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Package>
</Wix>
